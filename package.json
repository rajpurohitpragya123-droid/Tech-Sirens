{
  "name": "khet-doctor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix \"frontend/Project name\" -- --host 0.0.0.0",
    "build": "npm run build --prefix \"frontend/Project name\"",
    "test": "node --test tests/*.test.mjs",
    "mobile": "npm run start --prefix apps/mobile",
    "admin": "npm run dev --prefix apps/admin",
    "api": "node Backend/server.mjs",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
